---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Olá, sou o Antonio.</h1>
			<p>
				Desenvolvo customizações em TOTVS Fluig e Protheus (AdvPL/TLPP) e integrações entre
				sistemas, cada vez mais com IA no fluxo de trabalho. Aqui escrevo sobre o que aprendo
				resolvendo problemas reais.
			</p>

			<h2>Posts recentes</h2>
			<ul>
				{
					posts.map((post) => (
						<li>
							<FormattedDate date={post.data.pubDate} /> —{' '}
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</li>
					))
				}
			</ul>
			<p><a href="/blog">Ver todos os posts →</a></p>
		</main>
		<Footer />
	</body>
</html>
